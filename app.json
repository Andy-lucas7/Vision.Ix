{
  "expo": {
    "name": "Human Reflex Benchmark",
    "slug": "human-react-benchmark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0C"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0B0B0C",
      "bundleIdentifier": "com.humanreact.benchmark"
    },
    "android": {
      "package": "com.humanreact.benchmark",
      "backgroundColor": "#0B0B0C",
      "adaptiveIcon": {
        "backgroundColor": "#141416",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "df36ef9f-d2bb-4a4d-84b5-b3f4d1321974"
      }
    }
  }
}
